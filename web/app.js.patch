+// Handle time input changes
+function parseTimeInput(timeStr) {
+  const regex = /^([0-9]{2}):([0-9]{2})$/;
+  const match = timeStr.match(regex);
+  if (match) {
+    const hours = parseInt(match[1]);
+    const minutes = parseInt(match[2]);
+    if (hours >= 0 && hours <= 23 && minutes >= 0 && minutes <= 59) {
+      return hours * 60 + minutes;
+    }
+  }
+  return null;
+}
+
+$('run').onclick=()=>send({type:'running',value:!state?.running});$('reset').onclick=()=>send({type:'reset'});
+
+// Handle time input changes
+const timeInput = $('timeInput');
+if (timeInput) {
+  timeInput.addEventListener('change', function() {
+    const minutes = parseTimeInput(this.value);
+    if (minutes !== null) {
+      // Send the time change to backend
+      send({type:'setTime',value:minutes});
+    } else {
+      // Reset to previous value or show error
+      this.value = '12:00';
+    }
+  });
+}
