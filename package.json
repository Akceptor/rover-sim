{
  "name": "rover-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "sim": "node scripts/launch.mjs",
    "standalone": "node src/server.js --standalone --location-picker",
    "video": "node scripts/camera-stream.mjs",
    "terrain:import": "node scripts/import-terrain.mjs",
    "test": "node --test test/*.test.js",
    "test:locations": "node scripts/locations-smoke.mjs",
    "test:location-reload": "node scripts/location-reload-smoke.mjs",
    "test:terrain-selector": "node scripts/terrain-selector-smoke.mjs",
    "test:mission-planner-setup": "node scripts/mission-planner-setup-smoke.mjs",
    "test:terrain-retry": "node scripts/terrain-retry-smoke.mjs",
    "test:position": "node scripts/position-smoke.mjs",
    "test:vehicle-effects": "node scripts/vehicle-effects-smoke.mjs",
    "test:crawler": "node scripts/crawler-smoke.mjs",
    "test:weather": "node scripts/weather-smoke.mjs",
    "test:saved-locations": "node scripts/saved-locations-smoke.mjs",
    "test:map": "node scripts/map-smoke.mjs",
    "test:map-startup": "node scripts/map-startup-smoke.mjs",
    "test:osm": "node scripts/osm-smoke.mjs",
    "test:landcover": "node scripts/landcover-smoke.mjs",
    "test:barriers": "node scripts/barriers-smoke.mjs",
    "test:osm-settings": "node scripts/osm-settings-smoke.mjs",
    "test:terrain": "node scripts/terrain-smoke.mjs",
    "test:launcher": "node scripts/launcher-smoke.mjs",
    "test:sitl": "python3 scripts/integration.py",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:video": "node scripts/video-smoke.mjs",
    "test:camera-errors": "node scripts/camera-errors-smoke.mjs",
    "test:vehicles": "node scripts/vehicles-smoke.mjs",
    "test:profiles": "node scripts/profiles-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "geotiff": "3.0.5",
    "leaflet": "1.9.4",
    "playwright": "1.65.1",
    "proj4": "2.23.0",
    "three": "0.183.2",
    "ws": "8.21.0"
  }
}
