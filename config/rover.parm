# Simulation only. Conventional steering output 2 and reversible throttle output 4.
SERVO1_FUNCTION 0
SERVO2_FUNCTION 26
SERVO3_FUNCTION 0
SERVO4_FUNCTION 70
SERVO2_MIN 1000
SERVO2_TRIM 1500
SERVO2_MAX 2000
SERVO2_REVERSED 0
SERVO4_MIN 1000
SERVO4_TRIM 1500
SERVO4_MAX 2000
SERVO4_REVERSED 0
MOT_PWM_TYPE 0
MOT_THR_MIN 0
MOT_THR_MAX 100
CRUISE_SPEED 1.2
CRUISE_THROTTLE 35
ATC_ACCEL_MAX 1.5
ATC_DECEL_MAX 2
ATC_STR_RAT_MAX 90
ATC_TURN_MAX_G 0.3
WP_SPEED 1.2
WP_RADIUS 0.5
TURN_RADIUS 0.6
SCHED_LOOP_RATE 50
SIM_RATE_HZ 100
# Simulated RC defaults; allow driving from GCS without a physical receiver.
RC1_MIN 1000
RC1_TRIM 1500
RC1_MAX 2000
RC3_MIN 1000
RC3_TRIM 1500
RC3_MAX 2000
RCMAP_ROLL 1
RCMAP_THROTTLE 3
# RC5 is the simulator's arm/disarm switch. Existing EEPROM assignments take precedence.
RC5_OPTION 153
FS_THR_ENABLE 0
FS_GCS_ENABLE 0
# Keep EKF3 and simulated GPS/IMUs; do not use truth AHRS to conceal bad sensors.
AHRS_EKF_TYPE 3
EK3_ENABLE 1
LOG_DISARMED 1

# Dedicated receive-only HUD heartbeat and RC camera feed over SERIAL2.
SERIAL2_PROTOCOL 2

# RC2 tilt / RC4 pan telemetry at 10 Hz (existing EEPROM rates may override).
SR2_RC_CHAN 10

# Simulation-tab start coordinates on the receive-only SERIAL2 telemetry feed.
SR2_EXTRA1 2
SR2_POSITION 2
